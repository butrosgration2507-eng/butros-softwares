# Copy this file to .env (or just run: npm run setup). NEVER commit the real .env file.

# --- Basics ---
NODE_ENV=development
PORT=3000
# The public address of the site, with no trailing slash.
# Local: http://localhost:3000    Render: https://your-service.onrender.com    Later: https://yourdomain.com
APP_URL=http://localhost:3000
SITE_NAME=BUTROS SOFTWARES

# --- Database ---
# Local development with nothing to install (embedded Postgres, stored in ./.data):
DATABASE_URL=pglite:./.data/dev
# Production: a PostgreSQL connection string, e.g. from Neon
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- Security ---
# 32 random bytes, base64. Used to encrypt Google refresh tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If you lose or change this key, connected Google accounts must be reauthorized.
TOKEN_ENCRYPTION_KEY=
SESSION_TTL_HOURS=12

# --- Google OAuth (see README: "Google Cloud setup") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Defaults to APP_URL + /api/admin/drive/callback
GOOGLE_REDIRECT_URI=

# --- Optional ---
CONTACT_EMAIL=
# Google Search Console 'HTML tag' verification code (the content="..." value only)
GOOGLE_SITE_VERIFICATION=
# Number of reverse proxies in front of the app (Render = 1)
TRUST_PROXY=1
