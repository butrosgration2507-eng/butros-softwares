{
  "name": "butros-softwares",
  "version": "1.0.0",
  "private": true,
  "description": "BUTROS SOFTWARES - software distribution platform",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w web && npm run build -w server",
    "start": "npm run start -w server",
    "migrate": "npm run migrate -w server --",
    "create-admin": "npm run create-admin -w server --",
    "backup": "npm run backup -w server --",
    "restore": "npm run restore -w server --",
    "test": "npm run test -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web",
    "setup": "node scripts/setup.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}